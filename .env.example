# Frostwell Cakes environment variables. Copy to .env.local for local development.
# Never commit real values. On Vercel, set them in Project Settings → Environment Variables.

# Required in production: signs order links (HMAC-SHA256). Use a long random value, at least 32 characters,
# e.g. `openssl rand -base64 48`. Changing it invalidates all existing order links.
# In local development (NODE_ENV !== production) an insecure dev-only key is used if it's missing, with a warning.
ORDER_SECRET=

# Optional: send order emails through Gmail with nodemailer. Use a Google App Password, not your normal password.
# If either is missing, emails are written to the server log instead of being sent.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Optional: where new order requests (with Accept / Decline links) are sent. Defaults to GMAIL_USER.
BAKERY_EMAIL=

# Optional: absolute base URL for links in emails, e.g. https://frostwellcakes.example
# If unset: Vercel production uses VERCEL_PROJECT_PRODUCTION_URL, previews use VERCEL_BRANCH_URL / VERCEL_URL,
# and local development uses the request's Host header.
SITE_URL=

# Future (not used yet): PayPal Invoicing API v2. The current PayPal integration is a stub that only logs
# the invoice it would create, so none of these are read. Leave them commented out until a real integration exists.
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_API_BASE=   (the sandbox or live API base URL)
